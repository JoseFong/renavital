// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id                      Int     @id @default(autoincrement())
  name                    String
  equipment               Boolean
  price                   Decimal @db.Decimal(10, 2)
  active                  Boolean
  service                 Boolean
  productClassificationId Int?

  productClassification ProductClassification? @relation(fields: [productClassificationId], references: [id])
  productCategories     ProductCategory[]
  ruleTargets           RuleTarget[]
  rules                 Rule[]
}

model ProductClassification {
  id       Int    @id @default(autoincrement())
  name     String
  parentId Int?

  products Product[]
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean

  productCategories       ProductCategory[]
  configurationCategories ConfigurationCategories[]
  rules                   Rule[]
}

model ProductCategory {
  id         Int @id @default(autoincrement())
  productId  Int
  categoryId Int
  quantity   Int

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
}

model Procedure {
  id        Int     @id @default(autoincrement())
  code      String
  name      String
  active    Boolean
  shortForm String

  configurations Configuration[]
}

model Anesthesia {
  id        Int     @id @default(autoincrement())
  code      String
  name      String
  active    Boolean
  shortForm String

  configurations Configuration[]
}

model Stay {
  id        Int     @id @default(autoincrement())
  code      String
  name      String
  active    Boolean
  shortForm String

  configurations Configuration[]
}

model Configuration {
  id           Int     @id @default(autoincrement())
  code         String
  procedureId  Int
  anesthesiaId Int
  stayId       Int
  active       Boolean

  procedure  Procedure  @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  anesthesia Anesthesia @relation(fields: [anesthesiaId], references: [id], onDelete: Cascade)
  stay       Stay       @relation(fields: [stayId], references: [id], onDelete: Cascade)

  configurationCategories ConfigurationCategories[]
  exchangeRates           ExchangeRate[]
}

model ConfigurationCategories {
  id              Int     @id @default(autoincrement())
  configurationId Int
  categoryId      Int
  active          Boolean

  configuration Configuration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([configurationId, categoryId])
}

model Rule {
  id               Int    @id @default(autoincrement())
  triggerType      String
  type             String
  productSourceId  Int?
  categorySourceId Int?

  categorySource Category? @relation(fields: [categorySourceId], references: [id], onDelete: Cascade)
  productSource  Product?  @relation(fields: [productSourceId], references: [id], onDelete: Cascade)

  ruleTargets RuleTarget[]
}

model RuleTarget {
  id        Int @id @default(autoincrement())
  productId Int
  quantity  Int
  ruleId    Int

  rule    Rule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Patient {
  id Int @id @default(autoincrement())

  firstName      String
  lastName       String
  secondLastName String?

  birthday     String
  registeredAt String

  gender  String
  country String
  state   String
  city    String
  address String?

  curp           String?
  email          String?
  countryCode    String
  phone          String
  secondaryPhone String?

  observations String?

  bloodType  String?
  profession String?
  civilState String?
  language   String?

  codeUsages CodeUsage[]
}

model Specialty {
  id   Int    @id @default(autoincrement())
  name String

  doctorSpecialties DoctorSpecialty[]
}

model Doctor {
  id             Int     @id @default(autoincrement())
  firstName      String
  lastName       String
  secondLastName String?

  gender String
  curp   String? @unique
  rfc    String? @unique

  email          String? @unique
  countryCode    String
  phone          String  @unique
  secondaryPhone String?

  country String
  state   String
  city    String
  address String?

  university    String
  licenseNumber String

  observations String?

  defaultExchangeRate Float

  registeredAt String

  doctorSpecialties DoctorSpecialty[]
  exchangeRates     ExchangeRate[]
  codeUsages        CodeUsage[]
}

model DoctorSpecialty {
  id          Int @id @default(autoincrement())
  specialtyId Int
  doctorId    Int

  specialty Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

model ExchangeRate {
  id              Int   @id @default(autoincrement())
  doctorId        Int
  configurationId Int
  exchangeRate    Float

  configuration Configuration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  doctor        Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}

///////////////////////////////////////
////////CODIGOS DE DESCUENTO///////////
///////////////////////////////////////

model Code {
  id             Int     @id @default(autoincrement())
  code           String  @unique
  singleUse      Boolean
  maxUses        Int
  startDate      String?
  endDate        String?
  appliesToTotal Boolean
  discountType   String
  discount       Float
  valid          Boolean

  codeUsages CodeUsage[]
}

model CodeUsage {
  id           Int     @id @default(autoincrement())
  codeId       Int
  doctorId     Int?
  patientId    Int?
  numberOfUses Int
  valid        Boolean

  code Code @relation(fields: [codeId],references: [id],onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor?  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
}
